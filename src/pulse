get_package_count() {
    local parts=() n out p

    if command -v dpkg-query >/dev/null 2>&1; then
        n=$(dpkg-query -f '${db:Status-Abbrev}\n' -W 2>/dev/null | grep -c '^ii')
        parts+=("$n (dpkg)")
    elif command -v rpm >/dev/null 2>&1; then
        n=$(rpm -qa 2>/dev/null | wc -l)
        parts+=("$n (rpm)")
    elif command -v pacman >/dev/null 2>&1; then
        n=$(pacman -Qq 2>/dev/null | wc -l)
        parts+=("$n (pacman)")
    elif command -v xbps-query >/dev/null 2>&1; then
        n=$(xbps-query -l 2>/dev/null | wc -l)
        parts+=("$n (xbps)")
    elif command -v apk >/dev/null 2>&1; then
        n=$(apk info 2>/dev/null | wc -l)
        parts+=("$n (apk)")
    fi

    if command -v flatpak >/dev/null 2>&1; then
        n=$(flatpak list --app 2>/dev/null | wc -l)
        parts+=("$n (flatpak)")
    fi

    if [ "${#parts[@]}" -eq 0 ]; then
        echo "N/A"
        return
    fi

    out="${parts[0]}"
    for p in "${parts[@]:1}"; do
        out+=", $p"
    done
    echo "$out"
}

detect_wm() {
    local candidates=(kwin_x11 kwin_wayland mutter gnome-shell xfwm4 i3 i3wm
                       sway bspwm openbox awesome herbstluftwm dwm fluxbox
                       icewm marco cinnamon budgie-wm Hyprland niri river labwc
                       wayfire qtile xmonad cosmic-comp)
    local proc
    for proc in "${candidates[@]}"; do
        if pgrep -x "$proc" >/dev/null 2>&1; then
            case "$proc" in
                gnome-shell|mutter)
                    case "${XDG_SESSION_TYPE:-}" in
                        wayland) echo "Mutter (Wayland)" ;;
                        x11)     echo "Mutter (X11)" ;;
                        *)       echo "Mutter" ;;
                    esac
                    ;;
                *) echo "$proc" ;;
            esac
            return
        fi
    done
    echo "Unknown"
}

detect_terminal_emulator() {
    if [ -n "${KONSOLE_VERSION:-}" ]; then
        local kv="$KONSOLE_VERSION"
        if [[ "$kv" =~ ^[0-9]{6}$ ]]; then
            echo "Konsole $((10#${kv:0:2})).$((10#${kv:2:2})).$((10#${kv:4:2}))"
        else
            echo "Konsole"
        fi
    elif [ -n "${GNOME_TERMINAL_SCREEN:-}${GNOME_TERMINAL_SERVICE:-}" ]; then
        echo "GNOME Terminal"
    elif [ -n "${ALACRITTY_LOG:-}${ALACRITTY_SOCKET:-}" ]; then
        echo "Alacritty"
    elif [ -n "${KITTY_WINDOW_ID:-}" ]; then
        echo "kitty"
    elif [ -n "${WEZTERM_EXECUTABLE:-}" ]; then
        echo "WezTerm"
    elif [ -n "${TILIX_ID:-}" ]; then
        echo "Tilix"
    elif [ -n "${TERMINATOR_UUID:-}" ]; then
        echo "Terminator"
    elif [ -n "${TERM_PROGRAM:-}" ]; then
        echo "$TERM_PROGRAM"
    else
        local parent
        parent=$(ps -p "${PPID:-0}" -o comm= 2>/dev/null)
        echo "${parent:-${TERM:-unknown}}"
    fi
}

get_os_age() {
    local btime now days by bm bd ny nm nd months rem years
    btime=$(stat -c %W / 2>/dev/null)
    now=$(date +%s)
    if [[ "$btime" =~ ^[0-9]+$ ]] && [ "$btime" -gt 0 ]; then
        days=$(( (now - btime) / 86400 ))
        if [ "$days" -lt 60 ]; then
            echo "${days} days"
            return
        fi
        read -r by bm bd < <(date -d "@$btime" +'%Y %m %d')
        read -r ny nm nd < <(date -d "@$now" +'%Y %m %d')
        months=$(( (10#$ny - 10#$by) * 12 + 10#$nm - 10#$bm ))
        rem=$(( 10#$nd - 10#$bd ))
        if [ "$rem" -lt 0 ]; then
            months=$(( months - 1 ))
            rem=$(( rem + $(date -d "$ny-$nm-01 -1 day" +%d | sed 's/^0//') ))
        fi
        years=$(( months / 12 ))
        months=$(( months % 12 ))
        if [ "$years" -gt 0 ]; then
            if [ "$months" -gt 0 ]; then
                echo "${years}y ${months}m"
            else
                echo "${years}y"
            fi
        elif [ "$rem" -gt 0 ]; then
            echo "${months}m ${rem}d"
        else
            echo "${months}m"
        fi
    else
        echo "unknown"
    fi
}

UPTIME="0m"

set_uptime() {
    local up="${1%.*}" d h m
    d=$(( up / 86400 )); h=$(( (up % 86400) / 3600 )); m=$(( (up % 3600) / 60 ))
    if [ "$d" -gt 0 ]; then
        UPTIME="${d}d ${h}h ${m}m"
    elif [ "$h" -gt 0 ]; then
        UPTIME="${h}h ${m}m"
    else
        UPTIME="${m}m"
    fi
}

get_resolution_mutter() {
    local out mode w h hz scale lw lh res
    command -v gdbus >/dev/null 2>&1 || return 1
    out=$(gdbus call --session --timeout 2 --dest org.gnome.Mutter.DisplayConfig \
        --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.gnome.Mutter.DisplayConfig.GetCurrentState 2>/dev/null) || return 1

    mode=$(grep -oE "\('[0-9]+x[0-9]+@[0-9.]+', [0-9]+, [0-9]+, [0-9.]+, [0-9.]+, \[[^]]*\], \{'is-current'" <<<"$out" | head -1)
    [ -n "$mode" ] || return 1
    read -r w h hz < <(sed -E "s/^\('[0-9]+x[0-9]+@[0-9.]+', ([0-9]+), ([0-9]+), ([0-9.]+),.*/\1 \2 \3/" <<<"$mode")
    [[ "$w" =~ ^[0-9]+$ && "$h" =~ ^[0-9]+$ ]] || return 1

    scale=$(grep -oE "\(-?[0-9]+, -?[0-9]+, [0-9.]+, uint32 [0-9]+, true," <<<"$out" | head -1 | awk -F', ' '{print $3}')
    [[ "$scale" =~ ^[0-9]+(\.[0-9]+)?$ ]] || scale=1

    res="${w}x${h}"
    [[ "$hz" =~ ^[0-9.]+$ ]] && res+=$(awk -v z="$hz" 'BEGIN { printf " @ %.0fHz", z }')

    read -r lw lh < <(awk -v w="$w" -v h="$h" -v s="$scale" 'BEGIN { printf "%.0f %.0f", w / s, h / s }')
    if [ "$lw" != "$w" ] || [ "$lh" != "$h" ]; then
        res+=" (as ${lw}x${lh})"
    fi
    echo "$res"
}

get_resolution() {
    local logical="" hz="" line c mode status out

    case "${XDG_CURRENT_DESKTOP:-}" in
        *GNOME*)
            if out=$(get_resolution_mutter) && [ -n "$out" ]; then
                echo "$out"
                return
            fi
            ;;
    esac

    if command -v xrandr >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        line=$(xrandr --current 2>/dev/null | awk '/\*/ {
            for (i = 2; i <= NF; i++) if ($i ~ /\*/) {
                r = $i; gsub(/[*+]/, "", r); printf "%s %.0f", $1, r; exit
            }
        }')
        if [ -n "$line" ]; then
            logical="${line% *}"
            hz="${line#* }"
        fi
    fi
    if [ -z "$logical" ] && command -v xdpyinfo >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        logical=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')
    fi
    if [ -z "$logical" ]; then
        for c in /sys/class/drm/card*-*; do
            [ -r "$c/status" ] && [ -r "$c/modes" ] || continue
            read -r status < "$c/status"
            [ "$status" = "connected" ] || continue
            if read -r mode < "$c/modes"; then
                logical="$mode"
                break
            fi
        done
    fi

    [ -z "$logical" ] && { echo "N/A"; return; }
    [ -n "$hz" ] && logical+=" @ ${hz}Hz"
    echo "$logical"
}

hwmon_temp() {
    local h name t
    for h in /sys/class/hwmon/hwmon*; do
        [ -r "$h/name" ] && [ -r "$h/temp1_input" ] || continue
        read -r name < "$h/name" || continue
        [[ "$name" =~ $1 ]] || continue
        read -r t < "$h/temp1_input" || continue
        if [[ "$t" =~ ^[0-9]+$ ]]; then
            awk -v t="$t" 'BEGIN { printf "%.1f", t / 1000 }'
            return 0
        fi
    done
    return 1
}

NET_RX=0
NET_TX=0

read_net_totals() {
    local iface rx tx
    NET_RX=0
    NET_TX=0
    while IFS=': ' read -r iface rx _ _ _ _ _ _ _ tx _; do
        [[ "$rx" =~ ^[0-9]+$ ]] || continue
        [ "$iface" = "lo" ] && continue
        NET_RX=$(( NET_RX + rx ))
        NET_TX=$(( NET_TX + tx ))
    done < /proc/net/dev
}

wait_or_key() {
    local secs="$1" rc
    if [ -t 0 ]; then
        while true; do
            if [ "$RESIZED" = true ]; then
                RESIZED=false
                update_term_size
                redraw_static
            fi
            read -r -t "$secs" -n 1 _
            rc=$?
            [ "$rc" -eq 0 ] && return 0
            [ "$rc" -le 128 ] && return 1
            [ "$RESIZED" = true ] || return 1
        done
    else
        read -r -t 0.05 -n 1 _
        rc=$?
        [ "$rc" -eq 1 ] && return 0
        sleep "$secs"
        return 1
    fi
}

get_de() {
    local raw="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}" name="" ver=""
    case "$raw" in
        *GNOME*)
            name="GNOME"
            command -v gnome-shell >/dev/null 2>&1 &&
                ver=$(gnome-shell --version 2>/dev/null | grep -o '[0-9][0-9.]*' | head -1)
            ;;
        *KDE*)
            name="KDE Plasma"
            command -v plasmashell >/dev/null 2>&1 &&
                ver=$(plasmashell --version 2>/dev/null | grep -o '[0-9][0-9.]*' | head -1)
            ;;
        *Cinnamon*)
            name="Cinnamon"
            command -v cinnamon >/dev/null 2>&1 &&
                ver=$(cinnamon --version 2>/dev/null | grep -o '[0-9][0-9.]*' | head -1)
            ;;
        *XFCE*|*Xfce*)
            name="Xfce"
            command -v xfce4-session >/dev/null 2>&1 &&
                ver=$(xfce4-session --version 2>/dev/null | grep -m1 -o 'xfce4-session [0-9.]*' | cut -d' ' -f2)
            ;;
        "") name="Unknown" ;;
        *)  name="$raw" ;;
    esac
    echo "${name}${ver:+ $ver}"
}

