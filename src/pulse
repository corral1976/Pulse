draw_bar() {
    local pct=$1
    local len=${2:-35}
    local fill=$(( pct * len / 100 ))
    local i
    local bar_char
    local empty_char
    
    if [ "$TERM_TYPE" = "gui" ] && $USE_COLORS; then
        local bar_color="$COL_BAR_LOW"
        if [ "$pct" -ge 85 ]; then
            bar_color="$COL_BAR_HIGH"
        elif [ "$pct" -ge 60 ]; then
            bar_color="$COL_BAR_MED"
        fi
        for ((i=0; i<fill; i++)); do printf "%s█" "$bar_color"; done
        for ((i=fill; i<len; i++)); do printf "%s▒" "$COL_BAR_EMPTY"; done
        printf "%s" "$RESET"
    else
        bar_char="#"
        empty_char="."
        
        if [ "$pct" -ge 80 ]; then
            bar_char="!"
        elif [ "$pct" -ge 60 ]; then
            bar_char="*"
        elif [ "$pct" -ge 40 ]; then
            bar_char="+"
        elif [ "$pct" -ge 20 ]; then
            bar_char="-"
        else
            bar_char="|"
        fi
        
        for ((i=0; i<fill; i++)); do printf "%s" "$bar_char"; done
        for ((i=fill; i<len; i++)); do printf "%s" "$empty_char"; done
        printf " [%d%%]" "$pct"
    fi
}

# El historial no es uso crudo: se suaviza y se multiplica x3
# para que se noten los picos chicos.
draw_graph() {
    local val
    local b
    local chars
    
    if [ "$TERM_TYPE" = "gui" ] && $USE_UNICODE; then
        chars=(" " "▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
        for val in "${CPU_HISTORY[@]}"; do
            b=$(( val * 3 ))
            (( b > 100 )) && b=100
            printf "%s%s" "$COL_GRAPH" "${chars[$(( b * 8 / 100 ))]}"
        done
        printf "%s" "$RESET"
    else
        for val in "${CPU_HISTORY[@]}"; do
            if [ "$val" -lt 10 ]; then
                printf "."
            elif [ "$val" -lt 30 ]; then
                printf "_"
            elif [ "$val" -lt 50 ]; then
                printf "-"
            elif [ "$val" -lt 70 ]; then
                printf "+"
            elif [ "$val" -lt 90 ]; then
                printf "*"
            else
                printf "#"
            fi
        done
    fi
}

get_disk_info() {
    local out
    out=$(df -Pk "$1" 2>/dev/null | awk 'NR > 1 && NF >= 6 && $2 > 0 {
        printf "%dG %dG %d", $3 / 1048576, $2 / 1048576, int(($3 * 100) / $2); exit
    }')
    echo "${out:-0G 0G 0}"
}

format_temp() {
    local t="$1"
    if [ "$t" = "N/A" ] || [ -z "$t" ]; then
        echo "N/A"
    else
        echo "${t}°C"
    fi
}

safe_div() {
    local numerator=$1
    local denominator=$2
    [ "$denominator" -eq 0 ] && echo "0" || echo $(( numerator * 100 / denominator ))
}

# Corazón del modo TTY, compartido por la intro y el dashboard.
TTY_HEART=(
    "       .MMMM.  .MMMM. "
    "      .MMMMMM..MMMMMM."
    "      MMMMMMMMMMMMMMMM"
    "      MMMMMMMMMMMMMMMM"
    "      'MMMMMMMMMMMMMM'"
    "        'MMMMMMMMMM'  "
    "          'MMMMMM'    "
    "            'MM'      "
    "        PULSE-ACTIVE  "
)

# Refresca lo costoso (sensores, nvidia-smi, df, batería) una vez por TTL.
# Llamar desde el shell principal, no dentro de $(...).
refresh_slow_metrics() {
    if [ $(( SECONDS - SLOW_TS )) -ge "$CACHE_TTL" ]; then
        SLOW_TS=$SECONDS
        if command -v sensors >/dev/null 2>&1; then
            SENSORS_CACHE=$(sensors 2>/dev/null)
        fi
        if command -v nvidia-smi >/dev/null 2>&1; then
            NVIDIA_CACHE=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)
        fi
        CPU_TEMP_DISP=$(format_temp "$(get_cpu_temp)")
        GPU_TEMP_DISP=$(format_temp "$(get_gpu_temp)")
        read -r DISK_USED DISK_TOTAL DISK_P < <(get_disk_info "$DISK_PATH")
    fi
    if [ $(( SECONDS - BATTERY_TS )) -ge "$BATTERY_CACHE_TTL" ]; then
        BATTERY_TS=$SECONDS
        BATTERY_INFO=$(get_battery_info)
    fi
}

# Intro tipo demoscene: escribe el arte y los datos fijos letra por letra.
# Se salta con --quiet o con cualquier tecla.
play_intro() {
    [ "$QUIET_MODE" = true ] && return

    local skip=false
    local now_ts
    now_ts=$(date +'%H:%M:%S')

    # Escribe "$1" letra por letra (color "$2" opcional). Con una tecla
    # se imprime todo de golpe.
    _intro_type_line() {
        local text="$1" color="${2:-}" i char
        [ -n "$color" ] && printf "%s" "$color"
        if [ "$skip" = true ]; then
            printf "%s" "$text"
        else
            for (( i = 0; i < ${#text}; i++ )); do
                char="${text:i:1}"
                printf "%s" "$char"
                read -r -t 0.004 -n 1 _ 2>/dev/null && skip=true
            done
        fi
        [ -n "$color" ] && printf "%s" "$RESET"
        printf "\n"
    }

    if [ "$TERM_TYPE" = "gui" ]; then
        printf "\e[H\e[J\n"

        # Mismos printf del dashboard pero sin colores, para que quede igual.
        # ${C:-} porque C aún no existe y con `set -u` fallaría.
        local C_bak="${C:-}" RESET_bak="$RESET" COL_DIM_bak="$COL_DIM" COL_WHITE_bak="$COL_WHITE"
        local COL_G1_bak="$COL_G1" COL_G2_bak="$COL_G2" COL_G3_bak="$COL_G3" COL_G4_bak="$COL_G4"
        C=""; RESET=""; COL_DIM=""; COL_WHITE=""; COL_G1=""; COL_G2=""; COL_G3=""; COL_G4=""

        # DISK_P aún no existe, tomamos una muestra.
        local disk_p_now
        read -r _ _ disk_p_now < <(get_disk_info "$DISK_PATH")
        disk_p_now="${disk_p_now:-0}"

        local l01 l02 l03 l04 l05 l06 l07 l08 l09 l10 l11 l12
        l01=$(printf "      ${C} .MMMM.  .MMMM. ${RESET}    ${COL_G1}> user    ${COL_DIM}│ ${RESET}%s" "$USER_N")
        l02=$(printf "      ${C}.MMMMMM..MMMMMM.${RESET}    ${COL_G1}> uptime  ${COL_DIM}│ ${RESET}%s" "$UPTIME")
        l03=$(printf "      ${C}MMMMMMMMMMMMMMMM${RESET}    ${COL_G1}> display ${COL_DIM}│ ${RESET}%s" "$RES")
        l04=$(printf "      ${C}MMMMMMMMMMMMMMMM${RESET}    ${COL_G2}> distro  ${COL_DIM}│ ${RESET}%s" "$OS")
        l05=$(printf "      ${C}'MMMMMMMMMMMMMM'${RESET}    ${COL_G2}> kernel  ${COL_DIM}│ ${RESET}%s" "$KERNEL")
        l06=$(printf "      ${C}  'MMMMMMMMMM'  ${RESET}    ${COL_G2}> wm      ${COL_DIM}│ ${RESET}%s" "$WM")
        l07=$(printf "      ${C}    'MMMMMM'    ${RESET}    ${COL_G3}> desktop ${COL_DIM}│ ${RESET}%s" "$DE")
        l08=$(printf "      ${C}      'MM'      ${RESET}    ${COL_G3}> term    ${COL_DIM}│ ${RESET}%s" "$TERM_N")
        l09=$(printf "      ${C}  PULSE-ACTIVE  ${RESET}    ${COL_G3}> shell   ${COL_DIM}│ ${RESET}%s" "$SHELL_V")
        l10=$(printf "      ${COL_WHITE}   [%s]${RESET}       ${COL_G4}> apps    ${COL_DIM}│ ${RESET}%s" "$now_ts" "$PKGS")
        l11=$(printf "      ${COL_DIM}----------------${RESET}    ${COL_G4}> disk    ${COL_DIM}│ ${RESET}%s%%" "$disk_p_now")
        l12=$(printf "                        ${COL_G4}  > OS Age  ${COL_DIM}│ ${RESET}%s" "$OS_AGE")

        C="$C_bak"; RESET="$RESET_bak"; COL_DIM="$COL_DIM_bak"; COL_WHITE="$COL_WHITE_bak"
        COL_G1="$COL_G1_bak"; COL_G2="$COL_G2_bak"; COL_G3="$COL_G3_bak"; COL_G4="$COL_G4_bak"

        _intro_type_line "$l01" "$COL_WHITE"
        _intro_type_line "$l02" "$COL_WHITE"
        _intro_type_line "$l03" "$COL_WHITE"
        _intro_type_line "$l04" "$COL_WHITE"
        _intro_type_line "$l05" "$COL_WHITE"
        _intro_type_line "$l06" "$COL_WHITE"
        _intro_type_line "$l07" "$COL_WHITE"
        _intro_type_line "$l08" "$COL_WHITE"
        _intro_type_line "$l09" "$COL_WHITE"
        _intro_type_line "$l10" "$COL_G4"
        _intro_type_line "$l11" "$COL_G4"
        _intro_type_line "$l12" "$COL_G4"
    else
        printf '\e[H\e[2J'

        # Igual que arriba, con las líneas del modo TTY.
        local -a ttylines=()
        ttylines+=("$(printf "╔════════════════════════════════════════════════════════════════╗")")
        ttylines+=("$(printf "║                    PULSE-ACTIVE (TTY Mode)                     ║")")
        ttylines+=("$(printf "║                    Universal Edition v%-25s║" "${SCRIPT_VERSION}")")
        ttylines+=("$(printf "╚════════════════════════════════════════════════════════════════╝")")
        ttylines+=("")
        ttylines+=("${TTY_HEART[@]}")
        ttylines+=("$(printf "         [%s]" "$now_ts")")
        ttylines+=("")
        ttylines+=("$(printf "SYSTEM INFO:")")
        ttylines+=("$(printf "  User: %s" "${USER_N}")")
        ttylines+=("$(printf "  Time: %s" "$(date +'%H:%M')")")
        ttylines+=("$(printf "  Shell: %s" "${SHELL_V##*/}")")
        ttylines+=("$(printf "  Host: %s" "$HOST_N")")
        ttylines+=("$(printf "  Uptime: %s" "${UPTIME}")")
        ttylines+=("$(printf "  Kernel: %s" "${KERNEL}")")
        ttylines+=("$(printf "  OS: %s" "${OS}")")
        ttylines+=("$(printf "  Apps: %s" "${PKGS}")")
        ttylines+=("$(printf "  OS Age: %s" "${OS_AGE}")")

        local tline
        for tline in "${ttylines[@]}"; do
            _intro_type_line "$tline" ""
        done
    fi

    # Pausa corta antes del dashboard (también se salta con tecla).
    [ "$skip" = false ] && read -r -t 0.5 -n 1 _ 2>/dev/null

    unset -f _intro_type_line
}

# Dibuja un cuadro del dashboard GUI con la forma y el color del corazón
# que toque (fuerte en sístole, apagado en diástole). Lo demás sale igual.
draw_dashboard_gui() {
    local heart_mode="$1" hcolor="$2"
    local h1 h2 h3 h4 h5 h6 h7 h8

    if [ "$heart_mode" = "full" ]; then
        h1=" .MMMM.  .MMMM. "; h2=".MMMMMM..MMMMMM."; h3="MMMMMMMMMMMMMMMM"
        h4="MMMMMMMMMMMMMMMM"; h5="'MMMMMMMMMMMMMM'"; h6="  'MMMMMMMMMM'  "
        h7="    'MMMMMM'    "; h8="      'MM'      "
    else
        h1=" .::::.  .::::. "; h2=".::::::..::::::."; h3="::::::::::::::::"
        h4="::::::::::::::::"; h5="'::::::::::::::'"; h6="  '::::::::::'  "
        h7="    '::::::'    "; h8="      '::'      "
    fi

    local now_hms
    now_hms=$(date +'%H:%M:%S')

    printf "\e[H\e[J\n"
    printf "      %s%s%s    %s> user    %s│ %s%s\n" "$hcolor" "$h1" "$RESET" "$COL_G1" "$COL_DIM" "$RESET" "$USER_N"
    printf "      %s%s%s    %s> uptime  %s│ %s%s\n" "$hcolor" "$h2" "$RESET" "$COL_G1" "$COL_DIM" "$RESET" "$UPTIME"
    printf "      %s%s%s    %s> display %s│ %s%s\n" "$hcolor" "$h3" "$RESET" "$COL_G1" "$COL_DIM" "$RESET" "$RES"
    printf "      %s%s%s    %s> distro  %s│ %s%s\n" "$hcolor" "$h4" "$RESET" "$COL_G2" "$COL_DIM" "$RESET" "$OS"
    printf "      %s%s%s    %s> kernel  %s│ %s%s\n" "$hcolor" "$h5" "$RESET" "$COL_G2" "$COL_DIM" "$RESET" "$KERNEL"
    printf "      %s%s%s    %s> wm      %s│ %s%s\n" "$hcolor" "$h6" "$RESET" "$COL_G2" "$COL_DIM" "$RESET" "$WM"
    printf "      %s%s%s    %s> desktop %s│ %s%s\n" "$hcolor" "$h7" "$RESET" "$COL_G3" "$COL_DIM" "$RESET" "$DE"
    printf "      %s%s%s    %s> term    %s│ %s%s\n" "$hcolor" "$h8" "$RESET" "$COL_G3" "$COL_DIM" "$RESET" "$TERM_N"
    printf "      %s  PULSE-ACTIVE  %s    %s> shell   %s│ %s%s\n" "$hcolor" "$RESET" "$COL_G3" "$COL_DIM" "$RESET" "$SHELL_V"
    printf "      %s   [%s]%s       %s> apps    %s│ %s%s\n" "$COL_WHITE" "$now_hms" "$RESET" "$COL_G4" "$COL_DIM" "$RESET" "$PKGS"
    printf "      %s----------------%s    %s> disk    %s│ %s%s%%\n" "$COL_DIM" "$RESET" "$COL_G4" "$COL_DIM" "$RESET" "$DISK_P"
    printf "                        %s  > OS Age  %s│ %s%s\n" "$COL_G4" "$COL_DIM" "$RESET" "$OS_AGE"

    printf "\n    %sCPU %s %3d%% %s  %s%s%s\n" "$COL_G1" "$RESET" "$CPU" "$(draw_bar "$CPU")" "$COL_DIM" "$CPU_FREQ_DISP" "$RESET"
    printf "    %sRAM %s %3d%% %s  %s%s%s\n" "$COL_G2" "$RESET" "$RAM_P" "$(draw_bar "$RAM_P")" "$COL_DIM" "$RAM_STR" "$RESET"
    printf "    %sDSK %s %3d%% %s  %s%s/%s%s\n" "$COL_G3" "$RESET" "$DISK_P" "$(draw_bar "$DISK_P")" "$COL_DIM" "$DISK_USED" "$DISK_TOTAL" "$RESET"

    printf "\n    %sHistory: %s%s\n" "$COL_G4" "$RESET" "$(draw_graph)"
    printf "    %sNet:     %sD:%s KB/s U:%s KB/s\n" "$COL_G1" "$RESET" "$DL" "$UL"
    printf "    %sCPU:     %s%s @ %s\n" "$COL_G2" "$RESET" "$CPU_M" "$CPU_TEMP_DISP"
    printf "    %sGPU:     %s%s @ %s\n" "$COL_G3" "$RESET" "$GPU_M" "$GPU_TEMP_DISP"
    printf "    %sBattery: %s%s\n" "$COL_G4" "$RESET" "$BATTERY_INFO"

    printf "\n  %sCreated by Carlos Corral | Pulse Active v%s%s\n" "$COL_DIM" "$SCRIPT_VERSION" "$RESET"
    printf "  %sRepository: %shttps://github.com/corral1976/Pulse%s\n" "$COL_DIM" "$COL_G1" "$RESET"
    printf "  %sSupport: %shttps://ko-fi.com/retrolcdclock%s\n" "$COL_DIM" "$COL_G1" "$RESET"
}

# Primera lectura antes de la intro, para que el primer cuadro no muestre
# el promedio desde el arranque.
read -r _ u n s i w x y z _ < /proc/stat
PREV_T=$((u+n+s+i+w+x+y+z)); PREV_I=$((i+w))
read -r PREV_RX PREV_TX < <(net_totals)
read -r PREV_UP _ < /proc/uptime

if [ "$ONCE_MODE" = true ]; then
    sleep "$REFRESH_INTERVAL"
fi

play_intro

while true; do
    if ! read -r _ u n s i w x y z _ < /proc/stat 2>/dev/null; then
        sleep "$REFRESH_INTERVAL"
        continue
    fi
    T=$((u+n+s+i+w+x+y+z)); I=$((i+w))
    CPU=$(safe_div $((T - PREV_T - (I - PREV_I))) $((T - PREV_T)))
    PREV_T=$T; PREV_I=$I

    CPU_FREQ=$(awk -F: '/cpu MHz/ {printf "%d", $2; exit}' /proc/cpuinfo 2>/dev/null)
    if [ -z "$CPU_FREQ" ] && [ -r /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq ]; then
        read -r CPU_FREQ < /sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq
        if [[ "$CPU_FREQ" =~ ^[0-9]+$ ]]; then CPU_FREQ=$(( CPU_FREQ / 1000 )); else CPU_FREQ=""; fi
    fi
    if [ -z "$CPU_FREQ" ]; then
        CPU_FREQ_DISP="N/A"
    else
        CPU_FREQ_DISP="${CPU_FREQ} MHz"
    fi

    hist_len=${#CPU_HISTORY[@]}
    L=${CPU_HISTORY[$((hist_len - 1))]}
    D=$(( CPU - L ))
    O=$CPU
    if (( D > 5 )); then O=$(( CPU + D * 2 )); elif (( D < -5 )); then O=$(( CPU + D )); fi
    (( O < 0 )) && O=0; (( O > 100 )) && O=100
    S=$(( (L * 60 + O * 40) / 100 ))
    CPU_HISTORY=("${CPU_HISTORY[@]:1}" "$S")

    read -r TOTAL_K AVAIL_K < <(awk '
        /^MemTotal:/     {t=$2}
        /^MemAvailable:/ {a=$2}
        /^MemFree:/      {f=$2}
        /^Buffers:/      {b=$2}
        /^Cached:/       {c=$2}
        END { if (a == 0) a = f + b + c; print t + 0, a + 0 }' /proc/meminfo 2>/dev/null)
    used_k=$(( TOTAL_K - AVAIL_K ))
    RAM_P=$(safe_div "$used_k" "$TOTAL_K")
    RAM_STR=$(awk -v u="$used_k" -v t="$TOTAL_K" 'BEGIN { printf "%.2f/%.2f GiB", u / 1048576, t / 1048576 }')

    read -r RX TX < <(net_totals)
    read -r NOW_UP _ < /proc/uptime
    read -r DL UL < <(awk -v rx="$RX" -v tx="$TX" -v prx="$PREV_RX" -v ptx="$PREV_TX" \
                          -v now="$NOW_UP" -v prev="$PREV_UP" 'BEGIN {
        dt = now - prev; if (dt <= 0) dt = 1
        d = (rx - prx) / 1024 / dt; u = (tx - ptx) / 1024 / dt
        if (d < 0) d = 0; if (u < 0) u = 0
        printf "%d %d\n", d, u }')
    PREV_RX=$RX; PREV_TX=$TX; PREV_UP=$NOW_UP

    refresh_slow_metrics
    UPTIME="$(get_uptime)"

    if [ "$QUIET_MODE" = true ]; then
        QLINE=$(printf "[%s] CPU:%3d%%  RAM:%3d%%  DSK:%3d%%  NET D:%dKB/s U:%dKB/s  TEMP:%s" \
            "$(date +'%H:%M:%S')" "$CPU" "$RAM_P" "$DISK_P" "$DL" "$UL" "$CPU_TEMP_DISP")
        if [ "$ONCE_MODE" = true ] || [ ! -t 1 ]; then
            printf "%s\n" "$QLINE"
        else
            printf "\r\e[K%s" "$QLINE"
        fi
        [ "$ONCE_MODE" = true ] && break
        wait_or_key "$REFRESH_INTERVAL" && break
        continue
    fi

    if [ "$TERM_TYPE" = "gui" ]; then
        # El corazón late: lub, pausa, dub, pausa larga. Sin color
        # dibujamos un solo cuadro.
        if [ "$COLOR_MODE" = "none" ]; then
            draw_dashboard_gui full ""
            wait_or_key "$REFRESH_INTERVAL" && break
            continue
        fi

        draw_dashboard_gui full "$HEART_BRIGHT"
        wait_or_key 0.10 && break
        draw_dashboard_gui light "$HEART_DIM"
        wait_or_key 0.12 && break
        draw_dashboard_gui full "$HEART_BRIGHT"
        wait_or_key 0.10 && break
        draw_dashboard_gui light "$HEART_DIM"
        REST=$(awk -v r="$REFRESH_INTERVAL" 'BEGIN{v=r-0.32; if (v<0.1) v=0.1; printf "%.2f", v}')
        wait_or_key "$REST" && break
        continue
    else
        printf '\e[H\e[2J'

        printf "╔════════════════════════════════════════════════════════════════╗\n"
        printf "║                    PULSE-ACTIVE (TTY Mode)                     ║\n"
        printf "║                    Universal Edition v%-25s║\n" "${SCRIPT_VERSION}"
        printf "╚════════════════════════════════════════════════════════════════╝\n\n"

        printf '%s\n' "${TTY_HEART[@]}"
        printf "         [%s]\n\n" "$(date +'%H:%M:%S')"

        printf "SYSTEM INFO:\n"
        printf "  User: %s\n" "${USER_N}"
        printf "  Time: %s\n" "$(date +'%H:%M')"
        printf "  Shell: %s\n" "${SHELL_V##*/}"
        printf "  Host: %s\n" "$HOST_N"
        printf "  Uptime: %s\n" "${UPTIME}"
        printf "  Kernel: %s\n" "${KERNEL}"
        printf "  OS: %s\n" "${OS}"
        printf "  Apps: %s\n" "${PKGS}"
        printf "  OS Age: %s\n\n" "${OS_AGE}"

        printf "PERFORMANCE METRICS:\n"
        printf "  CPU: %3d%% %-20s %9s\n" "$CPU" "$(draw_bar "$CPU" 20)" "$(printf "%9s" "$CPU_FREQ_DISP")"
        printf "  RAM: %3d%% %-20s %5s GiB\n" "$RAM_P" "$(draw_bar "$RAM_P" 20)" "$(printf "%5s" "${RAM_STR%%/*}")"
        printf "  DSK: %3d%% %-20s %4s/%4s\n\n" "$DISK_P" "$(draw_bar "$DISK_P" 20)" "$DISK_USED" "$DISK_TOTAL"

        printf "TEMPERATURES & HARDWARE:\n"
        printf "  CPU: %s @ %s\n" "${CPU_M}" "$CPU_TEMP_DISP"
        printf "  GPU: %s @ %s\n" "${GPU_M}" "$GPU_TEMP_DISP"
        printf "  Battery: %s\n\n" "${BATTERY_INFO}"

        printf "NETWORK & HISTORY:\n"
        printf "  Net: Down:%7s KB/s │ Up:%7s KB/s │ History: %-18s\n" "$(printf "%7s" "$DL")" "$(printf "%7s" "$UL")" "$(draw_graph)"
        printf "\n"

        printf "Pulse-Active v%s - Universal Monitor - TTY Mode - Carlos Corral 2026\n" "${SCRIPT_VERSION}"
        printf "GitHub: https://github.com/corral1976/Pulse\n"
        printf "Support: https://ko-fi.com/retrolcdclock\n"

        wait_or_key "$REFRESH_INTERVAL" && break
    fi
done

if [ "$QUIET_MODE" = true ] && [ "$ONCE_MODE" = false ] && [ -t 1 ]; then
    printf "\n"
fi
exit 0
