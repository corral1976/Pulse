#
# pulse - Universal Edition (TTY + GUI) system monitor
#
# Sin `set -e` a propósito: aquí muchos comandos fallan de forma normal
# (grep sin resultados, herramientas opcionales que no están instaladas).
set -uo pipefail

readonly SCRIPT_VERSION="1.1.0"

REFRESH_INTERVAL=1
QUIET_MODE=false
SHOW_HELP=false
SHOW_VERSION=false
NO_COLOR_FLAG=false
ONCE_MODE=false
[ -n "${NO_COLOR:-}" ] && NO_COLOR_FLAG=true

while [[ $# -gt 0 ]]; do
    case $1 in
        -i|--interval)
            if [ $# -lt 2 ]; then
                echo "Error: ${1} requires a value (seconds)" >&2
                exit 1
            fi
            if ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -lt 1 ]; then
                echo "Error: --interval must be a positive integer" >&2
                exit 1
            fi
            REFRESH_INTERVAL="$2"
            shift 2
            ;;
        -q|--quiet)
            QUIET_MODE=true
            shift
            ;;
        -n|--no-color)
            NO_COLOR_FLAG=true
            shift
            ;;
        -1|--once)
            ONCE_MODE=true
            QUIET_MODE=true
            shift
            ;;
        -h|--help)
            SHOW_HELP=true
            shift
            ;;
        -v|--version)
            SHOW_VERSION=true
            shift
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Try 'pulse --help' for usage." >&2
            exit 2
            ;;
    esac
done

if [ "$SHOW_HELP" = true ]; then
    echo "Pulse-Active v${SCRIPT_VERSION}"
    echo "Usage: pulse [OPTIONS]"
    echo ""
    echo "Options:"
    echo "  -i, --interval SECONDS  Set refresh interval (default: 1)"
    echo "  -q, --quiet             Quiet mode (single-line minimal output)"
    echo "  -n, --no-color          Disable colored output (plain text, even in GUI mode)"
    echo "  -1, --once              Print one quiet-mode line and exit (implies --quiet)"
    echo "  -h, --help              Show this help message"
    echo "  -v, --version           Show version information"
    echo ""
    echo "Environment Variables:"
    echo "  DISK_PATH               Disk partition to monitor (default: /)"
    echo "  WM                      Override window manager auto-detection"
    echo "  NO_COLOR                Disable colored output (same as --no-color)"
    echo ""
    echo "When stdout is not a terminal (pipe, file, cron) quiet mode is used automatically."
    exit 0
fi

if [ "$SHOW_VERSION" = true ]; then
    echo "Pulse-Active v${SCRIPT_VERSION} - Universal Edition (TTY + GUI)"
    echo "Created by Carlos Corral | Pulse Active | 2026"
    exit 0
fi

# Si la salida no es una terminal (pipe, archivo, cron) no dibujamos el dashboard.
if [ ! -t 1 ]; then
    QUIET_MODE=true
fi

# Fabricante de la GPU según lspci. Sin lspci devuelve "unknown"
# y así no avisamos de nvidia-smi por error.
detect_gpu_vendor() {
    local pci_line=""
    if command -v lspci >/dev/null 2>&1; then
        pci_line=$(lspci 2>/dev/null | grep -iE 'vga|3d|display')
    fi
    if echo "$pci_line" | grep -qi 'nvidia'; then
        echo "nvidia"
    elif echo "$pci_line" | grep -qiE '\bamd\b|\bati\b|radeon'; then
        echo "amd"
    elif echo "$pci_line" | grep -qi 'intel'; then
        echo "intel"
    else
        echo "unknown"
    fi
}

check_dependencies() {
    # Sin estos no funciona
    local required=(awk grep sed cut df date stat uname stty sleep)
    # Opcionales: sin ellos solo se pierden algunos datos.
    # nvidia-smi solo se revisa si hay una GPU NVIDIA.
    local optional=(sensors lspci glxinfo upower xrandr pgrep ps)
    local missing_required=()
    local missing_optional=()
    local dep

    if [ "$(detect_gpu_vendor)" = "nvidia" ]; then
        optional+=(nvidia-smi)
    fi

    for dep in "${required[@]}"; do
        command -v "$dep" >/dev/null 2>&1 || missing_required+=("$dep")
    done
    for dep in "${optional[@]}"; do
        command -v "$dep" >/dev/null 2>&1 || missing_optional+=("$dep")
    done

    if [ "${#missing_required[@]}" -gt 0 ]; then
        echo "Error: missing essential commands: ${missing_required[*]}" >&2
        exit 1
    fi

    if [ "${#missing_optional[@]}" -gt 0 ] && [ "$QUIET_MODE" = false ]; then
        echo "Note: some optional features are reduced (not installed: ${missing_optional[*]})" >&2
    fi
}

check_dependencies

detect_terminal() {
    local term_type="unknown"
    local loc="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"

    # Consola de Linux o terminal básica: sin Unicode ni colores
    if [ "${TERM:-}" = "linux" ] || [ "${TERM:-}" = "dumb" ]; then
        term_type="tty"
    # Sesión gráfica: con que haya servidor basta, no exigimos xdpyinfo
    elif [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ] \
         || [ "${XDG_SESSION_TYPE:-}" = "wayland" ] || [ "${XDG_SESSION_TYPE:-}" = "x11" ]; then
        term_type="gui"
    # SSH, tmux, etc.: si el locale es UTF-8 se puede dibujar completo
    # (se mira stderr porque aquí stdout es un pipe)
    elif [ -t 2 ] && [[ "$loc" == *[Uu][Tt][Ff]-8* || "$loc" == *[Uu][Tt][Ff]8* ]]; then
        term_type="gui"
    elif [ -t 1 ] && [ -t 2 ]; then
        term_type="tty"
    fi

    echo "$term_type"
}

ORIGINAL_STTY=$(stty -g 2>/dev/null || echo "")
ALT_SCREEN=false

cleanup() {
    local rc=$?
    trap - INT TERM EXIT
    if [ "$ALT_SCREEN" = true ]; then
        printf "\e[?1049l\e[?25h\e[0m" 2>/dev/null || true
    fi
    if [ -n "$ORIGINAL_STTY" ]; then
        stty "$ORIGINAL_STTY" 2>/dev/null || true
    fi
    exit "$rc"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

TERM_TYPE=$(detect_terminal)

# Colores reales del terminal. tput devuelve -1 si no sabe (TERM=dumb),
# y en ese caso no usamos color.
detect_color_support() {
    local n=-1
    if command -v tput >/dev/null 2>&1; then
        n=$(tput colors 2>/dev/null || echo -1)
    fi
    echo "$n"
}

if [ "$TERM_TYPE" = "gui" ]; then
    if [ "$QUIET_MODE" = false ]; then
        printf "\e[?1049h\e[?25l"
        ALT_SCREEN=true
    fi
    USE_UNICODE=true
    if [ "$NO_COLOR_FLAG" = true ]; then
        USE_COLORS=false
        COLOR_MODE="none"
    else
        TERM_COLORS=$(detect_color_support)
        if [ "$TERM_COLORS" -ge 256 ] 2>/dev/null; then
            USE_COLORS=true
            COLOR_MODE="256"
        elif [ "$TERM_COLORS" -ge 8 ] 2>/dev/null; then
            USE_COLORS=true
            COLOR_MODE="16"
        else
            USE_COLORS=false
            COLOR_MODE="none"
        fi
    fi
else
    USE_COLORS=false
    USE_UNICODE=false
    COLOR_MODE="none"
fi

# Paleta pastel. Con menos de 256 colores usamos negritas ANSI;
# sin color (TTY o --no-color) las variables quedan vacías.
