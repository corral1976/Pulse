get_cpu_temp() {
    local temp="" z type raw=""

    temp=$(hwmon_temp '^(coretemp|k10temp|zenpower|cpu_thermal|cpu-thermal|soc_thermal)$') || temp=""

    if [ -z "$temp" ] && [ -n "$SENSORS_CACHE" ]; then
        temp=$(echo "$SENSORS_CACHE" | grep -E 'Tctl|Package id|Core 0|CPUTIN' | head -1 | grep -o '[+-][0-9]\+\.[0-9]\+' | head -1)
        temp="${temp#+}"
    fi

    if [ -z "$temp" ]; then
        for z in /sys/class/thermal/thermal_zone*; do
            [ -r "$z/type" ] && [ -r "$z/temp" ] || continue
            read -r type < "$z/type"
            case "$type" in
                x86_pkg_temp|*cpu*|*CPU*|soc*)
                    read -r raw < "$z/temp"
                    break
                    ;;
            esac
        done
        if [ -z "$raw" ] && [ -r /sys/class/thermal/thermal_zone0/temp ]; then
            read -r raw < /sys/class/thermal/thermal_zone0/temp
        fi
        if [[ "$raw" =~ ^[0-9]+$ ]]; then
            temp=$(awk -v t="$raw" 'BEGIN { printf "%.1f", t / 1000 }')
        fi
    fi
    echo "${temp:-N/A}"
}

get_gpu_temp() {
    local temp=""

    temp=$(hwmon_temp '^(amdgpu|radeon|nouveau)$') || temp=""
    [ -z "$temp" ] && temp="$NVIDIA_CACHE"
    [[ "$temp" =~ ^[0-9]+(\.[0-9]+)?$ ]] || temp=""
    echo "${temp:-N/A}"
}

get_battery_info() {
    local bat cap status battery percentage state

    for bat in /sys/class/power_supply/BAT*; do
        [ -r "$bat/capacity" ] || continue
        read -r cap < "$bat/capacity"
        status="unknown"
        [ -r "$bat/status" ] && read -r status < "$bat/status"
        echo "${cap}% (${status,,})"
        return
    done

    if command -v upower >/dev/null 2>&1; then
        battery=$(upower -e 2>/dev/null | grep battery | head -1)
        if [ -n "$battery" ]; then
            percentage=$(upower -i "$battery" 2>/dev/null | grep percentage | grep -o '[0-9]\+%' | head -1)
            state=$(upower -i "$battery" 2>/dev/null | grep state | awk '{print $2}' | head -1)
            if [ -n "$percentage" ]; then
                echo "${percentage} (${state})"
                return
            fi
        fi
    fi
    echo "No Battery"
}

get_gpu_name() {
    local name line vendor br rest
    name=$(glxinfo -B 2>/dev/null | grep -m1 "Device" | cut -d: -f2 | sed 's/^[ \t]*//;s/(.*//;s/[ \t]*$//')
    case "$name" in
        ""|"AMD Radeon Graphics") ;;
        *) echo "$name"; return ;;
    esac

    line=$(lspci 2>/dev/null | grep -iE 'vga|3d|display' | head -n1)
    if [ -z "$line" ]; then
        echo "${name:-Unknown GPU}"
        return
    fi
    line="${line#*: }"
    line="${line%% (rev*}"

    case "$line" in
        *Advanced\ Micro*|*AMD*|*ATI*) vendor="AMD" ;;
        *NVIDIA*)                      vendor="NVIDIA" ;;
        *Intel*)                       vendor="Intel" ;;
        *)                             vendor="" ;;
    esac

    br=""
    if [[ "$line" =~ \[([^][]*)\]$ ]]; then
        br="${BASH_REMATCH[1]}"
    fi
    if [ -n "$br" ] && [ "$br" != "AMD/ATI" ]; then
        br="${br%% / *}"
        name="${vendor:+$vendor }$br"
    else
        rest="${line#*Advanced Micro Devices, Inc. \[AMD/ATI\] }"
        rest="${rest#NVIDIA Corporation }"
        rest="${rest#Intel Corporation }"
        name="${vendor:+$vendor }$rest"
    fi
    echo "${name:-Unknown GPU}"
}

truncate_at_word() {
    local str="$1"
    local max="$2"
    local cut

    if [ "${#str}" -le "$max" ]; then
        echo "$str"
        return
    fi

    cut="${str:0:$max}"
    if [[ "$cut" == *" "* ]]; then
        cut="${cut% *}"
    fi
    echo "$cut"
}

