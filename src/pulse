    COL_G1=$'\e[1;38;5;117m'   # azul pastel  - user, uptime, display
    COL_G2=$'\e[1;38;5;120m'   # verde pastel - distro, kernel, wm
    COL_G3=$'\e[1;38;5;141m'   # lavanda      - desktop, term, shell
    COL_G4=$'\e[1;38;5;215m'   # durazno      - apps, disk, OS Age
    COL_BAR_LOW=$'\e[38;5;120m'
    COL_BAR_MED=$'\e[38;5;222m'
    COL_BAR_HIGH=$'\e[38;5;210m'
    COL_BAR_EMPTY=$'\e[90m'
    COL_DIM=$'\e[90m'
    COL_WHITE=$'\e[1;37m'
    COL_GRAPH=$'\e[38;5;117m'
    HEART_BRIGHT=$'\e[1;38;5;203m'
    HEART_DIM=$'\e[38;5;95m'
elif [ "$COLOR_MODE" = "16" ]; then
    RESET=$'\e[0m'
    COL_G1=$'\e[1;34m'
    COL_G2=$'\e[1;32m'
    COL_G3=$'\e[1;35m'
    COL_G4=$'\e[1;33m'
    COL_BAR_LOW=$'\e[1;32m'
    COL_BAR_MED=$'\e[1;33m'
    COL_BAR_HIGH=$'\e[1;31m'
    COL_BAR_EMPTY=$'\e[37m'
    COL_DIM=$'\e[37m'
    COL_WHITE=$'\e[1;37m'
    COL_GRAPH=$'\e[1;34m'
    HEART_BRIGHT=$'\e[1;31m'
    HEART_DIM=$'\e[31m'
else
    RESET=""; COL_G1=""; COL_G2=""; COL_G3=""; COL_G4=""
    COL_BAR_LOW=""; COL_BAR_MED=""; COL_BAR_HIGH=""; COL_BAR_EMPTY=""
    COL_DIM=""; COL_WHITE=""; COL_GRAPH=""
    HEART_BRIGHT=""; HEART_DIM=""
fi

DISK_PATH="${DISK_PATH:-/}"

if [ ! -d "$DISK_PATH" ]; then
    echo "Error: DISK_PATH '$DISK_PATH' does not exist or is not a directory" >&2
    DISK_PATH="/"
fi

# Sin /proc no hay nada que monitorear, salimos.
if [ ! -r /proc/stat ] || [ ! -r /proc/net/dev ] || [ ! -r /proc/meminfo ]; then
    echo "Error: /proc is not available or not readable. Pulse requires Linux with procfs mounted." >&2
    exit 1
fi

get_package_count() {
    local parts=() n out p

    if command -v dpkg-query >/dev/null 2>&1; then
        n=$(dpkg-query -f '${db:Status-Abbrev}\n' -W 2>/dev/null | grep -c '^ii')
        parts+=("$n (dpkg)")
    elif command -v rpm >/dev/null 2>&1; then
        n=$(rpm -qa 2>/dev/null | wc -l)
        parts+=("$n (rpm)")
    elif command -v pacman >/dev/null 2>&1; then
        n=$(pacman -Qq 2>/dev/null | wc -l)
        parts+=("$n (pacman)")
    elif command -v xbps-query >/dev/null 2>&1; then
        n=$(xbps-query -l 2>/dev/null | wc -l)
        parts+=("$n (xbps)")
    elif command -v apk >/dev/null 2>&1; then
        n=$(apk info 2>/dev/null | wc -l)
        parts+=("$n (apk)")
    fi

    if command -v flatpak >/dev/null 2>&1; then
        n=$(flatpak list --app 2>/dev/null | wc -l)
        parts+=("$n (flatpak)")
    fi

    if [ "${#parts[@]}" -eq 0 ]; then
        echo "N/A"
        return
    fi

    out="${parts[0]}"
    for p in "${parts[@]:1}"; do
        out+=", $p"
    done
    echo "$out"
}

detect_wm() {
    # Busca el WM por proceso. La variable WM tiene prioridad.
    local candidates=(kwin_x11 kwin_wayland mutter gnome-shell xfwm4 i3 i3wm
                       sway bspwm openbox awesome herbstluftwm dwm fluxbox
                       icewm marco cinnamon budgie-wm Hyprland niri river labwc
                       wayfire qtile xmonad cosmic-comp)
    local proc
    for proc in "${candidates[@]}"; do
        if pgrep -x "$proc" >/dev/null 2>&1; then
            echo "$proc"
            return
        fi
    done
    echo "Unknown"
}

detect_terminal_emulator() {
    # En Linux casi ningún terminal exporta TERM_PROGRAM, así que
    # primero miramos las variables de cada emulador.
    if [ -n "${KONSOLE_VERSION:-}" ]; then
        echo "Konsole"
    elif [ -n "${GNOME_TERMINAL_SCREEN:-}${GNOME_TERMINAL_SERVICE:-}" ]; then
        echo "GNOME Terminal"
    elif [ -n "${ALACRITTY_LOG:-}${ALACRITTY_SOCKET:-}" ]; then
        echo "Alacritty"
    elif [ -n "${KITTY_WINDOW_ID:-}" ]; then
        echo "kitty"
    elif [ -n "${WEZTERM_EXECUTABLE:-}" ]; then
        echo "WezTerm"
    elif [ -n "${TILIX_ID:-}" ]; then
        echo "Tilix"
    elif [ -n "${TERMINATOR_UUID:-}" ]; then
        echo "Terminator"
    elif [ -n "${TERM_PROGRAM:-}" ]; then
        echo "$TERM_PROGRAM"
    else
        local parent
        parent=$(ps -p "${PPID:-0}" -o comm= 2>/dev/null)
        echo "${parent:-${TERM:-unknown}}"
    fi
}

get_os_age() {
    # Fecha de creación de /. Si el sistema no la da, stat devuelve 0
    # y mostramos "unknown".
    local btime now days years months rem_days
    btime=$(stat -c %W / 2>/dev/null)
    now=$(date +%s)
    if [[ "$btime" =~ ^[0-9]+$ ]] && [ "$btime" -gt 0 ]; then
        days=$(( (now - btime) / 86400 ))
        if [ "$days" -ge 365 ]; then
            years=$(( days / 365 ))
            months=$(( (days % 365) / 30 ))
            if [ "$months" -gt 0 ]; then
                echo "${years}y ${months}m"
            else
                echo "${years}y"
            fi
        elif [ "$days" -ge 60 ]; then
            months=$(( days / 30 ))
            rem_days=$(( days % 30 ))
            if [ "$rem_days" -gt 0 ]; then
                echo "${months}m ${rem_days}d"
            else
                echo "${months}m"
            fi
        else
            echo "${days} days"
        fi
    else
        echo "unknown"
    fi
}

get_uptime() {
    local up d h m
    read -r up _ < /proc/uptime 2>/dev/null || { echo "Unknown"; return; }
    up="${up%.*}"
    d=$(( up / 86400 )); h=$(( (up % 86400) / 3600 )); m=$(( (up % 3600) / 60 ))
    if [ "$d" -gt 0 ]; then
        echo "${d}d ${h}h ${m}m"
    elif [ "$h" -gt 0 ]; then
        echo "${h}h ${m}m"
    else
        echo "${m}m"
    fi
}

# Resolución: xrandr -> xdpyinfo -> DRM. Si nada funciona, N/A.
get_resolution() {
    local res="" c mode status

    if command -v xrandr >/dev/null 2>&1 && { [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; }; then
        res=$(xrandr --current 2>/dev/null | awk '/\*/ {
            for (i = 2; i <= NF; i++) if ($i ~ /\*/) {
                r = $i; gsub(/[*+]/, "", r); printf "%s @ %.0fHz", $1, r; exit
            }
        }')
    fi
    if [ -z "$res" ] && command -v xdpyinfo >/dev/null 2>&1 && [ -n "${DISPLAY:-}" ]; then
        res=$(xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2; exit}')
    fi
    if [ -z "$res" ]; then
        for c in /sys/class/drm/card*-*; do
            [ -r "$c/status" ] && [ -r "$c/modes" ] || continue
            read -r status < "$c/status"
            [ "$status" = "connected" ] || continue
            if read -r mode < "$c/modes"; then
                res="$mode"
                break
            fi
        done
    fi
    echo "${res:-N/A}"
}

# Temperatura (°C) del primer hwmon cuyo nombre coincida con la regex $1.
# Lee sysfs directo, no necesita lm-sensors.
hwmon_temp() {
    local h name t
    for h in /sys/class/hwmon/hwmon*; do
        [ -r "$h/name" ] && [ -r "$h/temp1_input" ] || continue
        read -r name < "$h/name" || continue
        [[ "$name" =~ $1 ]] || continue
        read -r t < "$h/temp1_input" || continue
        if [[ "$t" =~ ^[0-9]+$ ]]; then
            awk -v t="$t" 'BEGIN { printf "%.1f", t / 1000 }'
            return 0
        fi
    done
    return 1
}

# Suma bytes rx/tx de todas las interfaces menos lo.
net_totals() {
    awk 'NR > 2 {
        i = index($0, ":"); if (i == 0) next
        name = substr($0, 1, i - 1); gsub(/ /, "", name)
        if (name == "lo") next
        split(substr($0, i + 1), f, " ")
        rx += f[1]; tx += f[9]
    } END { printf "%.0f %.0f\n", rx, tx }' /proc/net/dev 2>/dev/null
}

# Espera N segundos. Devuelve 0 si hay que salir (tecla o EOF en stdin).
# Si stdin no es terminal duerme normal, para no quemar CPU.
wait_or_key() {
    local secs="$1" rc
    if [ -t 0 ]; then
        read -r -t "$secs" -n 1 _
        rc=$?
        [ "$rc" -eq 0 ] && return 0
        [ "$rc" -gt 128 ] && return 1
    else
        # Sin terminal: si stdin ya está cerrado (< /dev/null) salimos;
        # con un pipe abierto solo dormimos.
        read -r -t 0.05 -n 1 _
        rc=$?
        [ "$rc" -eq 1 ] && return 0
        sleep "$secs"
        return 1
    fi
}

