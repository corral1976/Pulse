calc_percent() {
    if [ "$2" -le 0 ] || [ "$1" -le 0 ]; then
        PERCENT=0
    else
        PERCENT=$(( $1 * 100 / $2 ))
        (( PERCENT > 100 )) && PERCENT=100
    fi
}

draw_bar() {
    local pct=$1
    local len=${2:-$BAR_WIDTH_GUI}
    local fill=$(( pct * len / 100 ))
    local i filled="" empty="" fill_char empty_char
    local fill_color="" empty_color="" end_color=""

    if [ "$TERM_TYPE" = "gui" ] && $USE_COLORS; then
        fill_color="$COL_BAR_LOW"
        if [ "$pct" -ge 85 ]; then
            fill_color="$COL_BAR_HIGH"
        elif [ "$pct" -ge 60 ]; then
            fill_color="$COL_BAR_MED"
        fi
        empty_color="$COL_BAR_EMPTY"
        end_color="$RESET"
        fill_char="█"
        empty_char="▒"
    else
        empty_char="."
        if [ "$pct" -ge 80 ]; then
            fill_char="!"
        elif [ "$pct" -ge 60 ]; then
            fill_char="*"
        elif [ "$pct" -ge 40 ]; then
            fill_char="+"
        elif [ "$pct" -ge 20 ]; then
            fill_char="-"
        else
            fill_char="|"
        fi
    fi

    for (( i = 0; i < fill; i++ )); do filled+="$fill_char"; done
    for (( i = fill; i < len; i++ )); do empty+="$empty_char"; done
    BAR_OUT="${fill_color}${filled}${empty_color}${empty}${end_color}"
}

draw_graph() {
    local val b
    local -a chars

    GRAPH_OUT=""
    if [ "$TERM_TYPE" = "gui" ] && $USE_UNICODE; then
        chars=("▁" "▁" "▂" "▃" "▄" "▅" "▆" "▇" "█")
        for val in "${CPU_HISTORY[@]}"; do
            b=$(( val * 3 ))
            (( b > 100 )) && b=100
            GRAPH_OUT+="${chars[$(( b * 8 / 100 ))]}"
        done
        GRAPH_OUT="${COL_GRAPH}${GRAPH_OUT}${RESET}"
    else
        for val in "${CPU_HISTORY[@]}"; do
            if [ "$val" -lt 10 ]; then
                GRAPH_OUT+="."
            elif [ "$val" -lt 30 ]; then
                GRAPH_OUT+="_"
            elif [ "$val" -lt 50 ]; then
                GRAPH_OUT+="-"
            elif [ "$val" -lt 70 ]; then
                GRAPH_OUT+="+"
            elif [ "$val" -lt 90 ]; then
                GRAPH_OUT+="*"
            else
                GRAPH_OUT+="#"
            fi
        done
    fi
}

get_disk_info() {
    local out
    out=$(df -Pk "$1" 2>/dev/null | awk 'NR > 1 && NF >= 6 && $2 > 0 {
        printf "%dG %dG %d", $3 / 1048576, $2 / 1048576, int(($3 * 100) / $2); exit
    }')
    echo "${out:-0G 0G 0}"
}

format_temp() {
    local t="$1"
    if [ "$t" = "N/A" ] || [ -z "$t" ]; then
        echo "N/A"
    else
        echo "${t}°C"
    fi
}

refresh_slow_metrics() {
    if [ $(( SECONDS - SLOW_TS )) -ge "$CACHE_TTL" ]; then
        SLOW_TS=$SECONDS
        if command -v sensors >/dev/null 2>&1; then
            SENSORS_CACHE=$(sensors 2>/dev/null)
        fi
        if command -v nvidia-smi >/dev/null 2>&1; then
            NVIDIA_CACHE=$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -n1)
        fi
        CPU_TEMP_DISP=$(format_temp "$(get_cpu_temp)")
        GPU_TEMP_DISP=$(format_temp "$(get_gpu_temp)")
        read -r DISK_USED DISK_TOTAL DISK_P < <(get_disk_info "$DISK_PATH")
    fi
    if [ $(( SECONDS - BATTERY_TS )) -ge "$BATTERY_CACHE_TTL" ]; then
        BATTERY_TS=$SECONDS
        BATTERY_INFO=$(get_battery_info)
    fi
}

read_cpu_ticks() {
    local cpu_user cpu_nice cpu_system cpu_idle cpu_iowait cpu_irq cpu_softirq cpu_steal
    read -r _ cpu_user cpu_nice cpu_system cpu_idle cpu_iowait cpu_irq cpu_softirq cpu_steal _ < /proc/stat 2>/dev/null || return 1
    CPU_TOTAL=$(( cpu_user + cpu_nice + cpu_system + cpu_idle + cpu_iowait + cpu_irq + cpu_softirq + cpu_steal ))
    CPU_IDLE=$(( cpu_idle + cpu_iowait ))
}

read_cpu_freq() {
    local freq="" scaling=/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq

    if [ -r "$scaling" ]; then
        read -r freq < "$scaling" 2>/dev/null
        if [[ "$freq" =~ ^[0-9]+$ ]]; then
            freq=$(( freq / 1000 ))
        else
            freq=""
        fi
    fi
    if [ -z "$freq" ]; then
        freq=$(awk -F: '/cpu MHz/ {printf "%d", $2; exit}' /proc/cpuinfo 2>/dev/null)
    fi
    if [ -z "$freq" ]; then
        CPU_FREQ_DISP="N/A"
    else
        CPU_FREQ_DISP="${freq} MHz"
    fi
}

update_cpu_history() {
    local last delta peak smooth
    last=${CPU_HISTORY[$(( ${#CPU_HISTORY[@]} - 1 ))]}
    delta=$(( CPU - last ))
    peak=$CPU
    if (( delta > 5 )); then
        peak=$(( CPU + delta * 2 ))
    elif (( delta < -5 )); then
        peak=$(( CPU + delta ))
    fi
    (( peak < 0 )) && peak=0
    (( peak > 100 )) && peak=100
    smooth=$(( (last * 60 + peak * 40) / 100 ))
    CPU_HISTORY=("${CPU_HISTORY[@]:1}" "$smooth")
}

read_memory() {
    local key value mem_total=0 mem_free=0 mem_avail=0 buffers=0 cached=0
    local used_kib used_centi total_centi

    while read -r key value _; do
        case "$key" in
            MemTotal:)     mem_total=$value ;;
            MemFree:)      mem_free=$value ;;
            MemAvailable:) mem_avail=$value ;;
            Buffers:)      buffers=$value ;;
            Cached:)       cached=$value; break ;;
        esac
    done < /proc/meminfo

    (( mem_avail == 0 )) && mem_avail=$(( mem_free + buffers + cached ))
    used_kib=$(( mem_total - mem_avail ))
    calc_percent "$used_kib" "$mem_total"
    RAM_P=$PERCENT
    used_centi=$(( (used_kib * 100 + 524288) / 1048576 ))
    total_centi=$(( (mem_total * 100 + 524288) / 1048576 ))
    printf -v RAM_STR '%d.%02d/%d.%02d GiB' \
        $(( used_centi / 100 )) $(( used_centi % 100 )) $(( total_centi / 100 )) $(( total_centi % 100 ))
}

update_net_rates() {
    local now_cs prev_cs elapsed_cs
    now_cs=$(( 10#${NOW_UP/./} ))
    prev_cs=$(( 10#${PREV_UP/./} ))
    elapsed_cs=$(( now_cs - prev_cs ))
    (( elapsed_cs <= 0 )) && elapsed_cs=100
    DL=$(( (NET_RX - PREV_RX) * 100 / (1024 * elapsed_cs) ))
    UL=$(( (NET_TX - PREV_TX) * 100 / (1024 * elapsed_cs) ))
    (( DL < 0 )) && DL=0
    (( UL < 0 )) && UL=0
}

fit_frame() {
    local count="$1"
    [ "$TERM_ROWS" -gt 0 ] || return 0
    while (( count > TERM_ROWS )); do
        FRAME="${FRAME%$'\n'}"
        FRAME="${FRAME%$'\n'*}"$'\n'
        (( count-- ))
    done
}

frame_line() {
    local text
    printf -v text "$@"
    FRAME+="${text}"$'\e[K\n'
    (( FRAME_LINES++ ))
}

fill_gui_rows() {
    local mode="$1" heart_mode="$2" hcolor="$3"
    local g1="$COL_G1" g2="$COL_G2" g3="$COL_G3" g4="$COL_G4"
    local dim="$COL_DIM" white="$COL_WHITE" reset="$RESET"
    local i
    local -a art keys values tones

    if [ "$mode" = "plain" ]; then
        g1=""; g2=""; g3=""; g4=""; dim=""; white=""; reset=""; hcolor=""
    fi
    if [ "$heart_mode" = "full" ]; then
        art=("${HEART_FULL[@]}")
    else
        art=("${HEART_LIGHT[@]}")
    fi
    keys=(user uptime display distro kernel wm desktop term shell)
    values=("$USER_N" "$UPTIME" "$RES" "$OS" "$KERNEL" "$WM" "$DE" "$TERM_N" "$SHELL_V")
    tones=("$g1" "$g2" "$g3")

    for (( i = 0; i < 9; i++ )); do
        printf -v "GUI_ROWS[$i]" '      %s%s%s    %s> %-8s%s│ %s%s' \
            "$hcolor" "${art[i]}" "$reset" "${tones[i / 3]}" "${keys[i]}" "$dim" "$reset" "${values[i]}"
    done
    printf -v "GUI_ROWS[9]" '      %s   [%s]%s       %s> apps    %s│ %s%s' \
        "$white" "$NOW_HMS" "$reset" "$g4" "$dim" "$reset" "$PKGS"
    printf -v "GUI_ROWS[10]" '      %s----------------%s    %s> disk    %s│ %s%s%%' \
        "$dim" "$reset" "$g4" "$dim" "$reset" "$DISK_P"
    printf -v "GUI_ROWS[11]" '                        %s  > OS Age  %s│ %s%s' \
        "$g4" "$dim" "$reset" "$OS_AGE"
}

build_tty_header() {
    local border
    printf -v border '+%64s+' ''
    border="${border// /-}"
    TTY_HEADER=("$border")
    printf -v "TTY_HEADER[1]" '|%20s%-44s|' '' 'PULSE-ACTIVE (TTY Mode)'
    printf -v "TTY_HEADER[2]" '|%20s%-44s|' '' "Universal Edition v${SCRIPT_VERSION}"
    TTY_HEADER[3]="$border"
}

fill_tty_rows() {
    local i art_line side
    local -a labels values

    labels=(User Time Shell Host Uptime Kernel OS Apps "OS Age")
    values=("$USER_N" "${NOW_HMS%:*}" "$SHELL_V" "$HOST_N" "$UPTIME" "$KERNEL" "$OS" "$PKGS" "$OS_AGE")

    for (( i = 0; i < 10; i++ )); do
        if (( i < 9 )); then
            art_line="${HEART_FULL[i]}"
        else
            printf -v art_line '   [%s]' "$NOW_HMS"
        fi
        if (( i == 0 )); then
            side="SYSTEM INFO:"
        else
            printf -v side '%-7s: %.40s' "${labels[i - 1]}" "${values[i - 1]}"
        fi
        printf -v "TTY_ROWS[$i]" '      %-16s    %s' "$art_line" "$side"
    done
}

type_line() {
    local text="$1" color="${2:-}" i

    [ -n "$color" ] && printf '%s' "$color"
    if [ "$INTRO_SKIP" = true ]; then
        printf '%s' "$text"
    else
        for (( i = 0; i < ${#text}; i++ )); do
            printf '%s' "${text:i:1}"
            if read -r -t 0.004 -n 1 _ 2>/dev/null; then
                INTRO_SKIP=true
                printf '%s' "${text:i+1}"
                break
            fi
        done
    fi
    [ -n "$color" ] && printf '%s' "$RESET"
    printf '\n'
}

play_intro() {
    [ "$QUIET_MODE" = true ] && return
    [ "$NO_INTRO" = true ] && return

    local i line color

    update_clock

    if [ "$TERM_TYPE" = "gui" ]; then
        printf '\e[H\e[J\n'
        read -r _ _ DISK_P < <(get_disk_info "$DISK_PATH")
        fill_gui_rows plain full ""
        for (( i = 0; i < ${#GUI_ROWS[@]}; i++ )); do
            if (( i < 9 )); then color="$COL_WHITE"; else color="$COL_G4"; fi
            type_line "${GUI_ROWS[i]}" "$color"
        done
    else
        printf '\e[H\e[J'
        fill_tty_rows
        for line in "${TTY_HEADER[@]}" "" "${TTY_ROWS[@]}"; do
            type_line "$line" ""
        done
    fi

    [ "$INTRO_SKIP" = false ] && read -r -t 0.5 -n 1 _ 2>/dev/null
}

build_gui_tail() {
    FRAME=""
    FRAME_LINES=0
    frame_line ''
    draw_bar "$CPU"
    frame_line '    %sCPU %s %3d%% %s  %s%s%s' "$COL_G1" "$RESET" "$CPU" "$BAR_OUT" "$COL_DIM" "$CPU_FREQ_DISP" "$RESET"
    draw_bar "$RAM_P"
    frame_line '    %sRAM %s %3d%% %s  %s%s%s' "$COL_G2" "$RESET" "$RAM_P" "$BAR_OUT" "$COL_DIM" "$RAM_STR" "$RESET"
    draw_bar "$DISK_P"
    frame_line '    %sDSK %s %3d%% %s  %s%s/%s%s' "$COL_G3" "$RESET" "$DISK_P" "$BAR_OUT" "$COL_DIM" "$DISK_USED" "$DISK_TOTAL" "$RESET"
    frame_line ''
    draw_graph
    frame_line '    %sHistory: %s%s' "$COL_G4" "$RESET" "$GRAPH_OUT"
    frame_line '    %sNet:     %sD:%s KB/s U:%s KB/s' "$COL_G1" "$RESET" "$DL" "$UL"
    frame_line '    %sCPU:     %s%s @ %s' "$COL_G2" "$RESET" "$CPU_M" "$CPU_TEMP_DISP"
    frame_line '    %sGPU:     %s%s @ %s' "$COL_G3" "$RESET" "$GPU_M" "$GPU_TEMP_DISP"
    frame_line '    %sBattery: %s%s' "$COL_G4" "$RESET" "$BATTERY_INFO"
    frame_line ''
    frame_line '  %sCreated by Carlos Corral | Pulse Active v%s%s' "$COL_DIM" "$SCRIPT_VERSION" "$RESET"
    frame_line '  %sRepository: %shttps://github.com/corral1976/Pulse%s' "$COL_DIM" "$COL_G1" "$RESET"
    frame_line '  %sSupport: %shttps://ko-fi.com/retrolcdclock%s' "$COL_DIM" "$COL_G1" "$RESET"
    GUI_TAIL="$FRAME"
    GUI_TAIL_LINES=$FRAME_LINES
}

build_gui_frame() {
    local row

    fill_gui_rows color "$1" "$2"
    FRAME=$'\e[K\n'
    for row in "${GUI_ROWS[@]}"; do
        FRAME+="${row}"$'\e[K\n'
    done
    FRAME+="$GUI_TAIL"
    fit_frame $(( ${#GUI_ROWS[@]} + 1 + GUI_TAIL_LINES ))
    FRAME="${FRAME%$'\n'}"
}

emit_gui_frame() {
    printf '\e[?2026h\e[H%s\e[J\e[?2026l' "$1"
}

build_tty_frame() {
    local line

    FRAME=""
    FRAME_LINES=0
    if [ "$TERM_ROWS" -eq 0 ] || [ "$TERM_ROWS" -ge "$TTY_FULL_ROWS" ]; then
        for line in "${TTY_HEADER[@]}"; do
            frame_line '%s' "$line"
        done
        frame_line ''
    fi
    fill_tty_rows
    for line in "${TTY_ROWS[@]}"; do
        frame_line '%s' "$line"
    done
    frame_line ''
    frame_line 'PERFORMANCE METRICS:'
    draw_bar "$CPU" "$BAR_WIDTH_TTY"
    frame_line '  CPU: %3d%% %s %9s' "$CPU" "$BAR_OUT" "$CPU_FREQ_DISP"
    draw_bar "$RAM_P" "$BAR_WIDTH_TTY"
    frame_line '  RAM: %3d%% %s %5s GiB' "$RAM_P" "$BAR_OUT" "${RAM_STR%%/*}"
    draw_bar "$DISK_P" "$BAR_WIDTH_TTY"
    frame_line '  DSK: %3d%% %s %4s/%4s' "$DISK_P" "$BAR_OUT" "$DISK_USED" "$DISK_TOTAL"
    frame_line ''
    frame_line 'TEMPERATURES & HARDWARE:'
    frame_line '  CPU: %s @ %s' "$CPU_M" "${CPU_TEMP_DISP/°C/C}"
    frame_line '  GPU: %s @ %s' "$GPU_M" "${GPU_TEMP_DISP/°C/C}"
    frame_line '  Battery: %s' "$BATTERY_INFO"
    frame_line ''
    frame_line 'NETWORK & HISTORY:'
    draw_graph
    frame_line '  Net: Down:%7s KB/s | Up:%7s KB/s | History: %s' "$DL" "$UL" "$GRAPH_OUT"
    frame_line ''
    frame_line 'Pulse-Active v%s - Universal Monitor - TTY Mode - Carlos Corral 2026' "$SCRIPT_VERSION"
    frame_line 'GitHub: https://github.com/corral1976/Pulse'
    frame_line 'Support: https://ko-fi.com/retrolcdclock'
    fit_frame "$FRAME_LINES"
    FRAME="${FRAME%$'\n'}"
}

emit_tty_frame() {
    printf '\e[H%s\e[J' "$FRAME"
}

redraw_static() {
    if [ "$TERM_TYPE" = "gui" ]; then
        build_gui_tail
        build_gui_frame full "$HEART_BRIGHT"
        emit_gui_frame "$FRAME"
    else
        build_tty_frame
        emit_tty_frame
    fi
}

read_cpu_ticks
PREV_CPU_TOTAL=$CPU_TOTAL
PREV_CPU_IDLE=$CPU_IDLE
read_net_totals
PREV_RX=$NET_RX
PREV_TX=$NET_TX
read -r PREV_UP _ < /proc/uptime 2>/dev/null || PREV_UP="0.00"
set_uptime "$PREV_UP"
build_tty_header

if [ "$ONCE_MODE" = true ]; then
    sleep "$REFRESH_INTERVAL"
fi

HEART_REST_MS=$(( REFRESH_INTERVAL * 1000 - HEART_CYCLE_MS ))
(( HEART_REST_MS < HEART_REST_MIN_MS )) && HEART_REST_MS=$HEART_REST_MIN_MS
printf -v HEART_REST '%d.%03d' $(( HEART_REST_MS / 1000 )) $(( HEART_REST_MS % 1000 ))

play_intro

while true; do
    if ! read_cpu_ticks; then
        sleep "$REFRESH_INTERVAL"
        continue
    fi
    calc_percent $(( CPU_TOTAL - PREV_CPU_TOTAL - (CPU_IDLE - PREV_CPU_IDLE) )) $(( CPU_TOTAL - PREV_CPU_TOTAL ))
    CPU=$PERCENT
    PREV_CPU_TOTAL=$CPU_TOTAL
    PREV_CPU_IDLE=$CPU_IDLE

    read_cpu_freq
    update_cpu_history
    read_memory

    read_net_totals
    read -r NOW_UP _ < /proc/uptime 2>/dev/null || NOW_UP="$PREV_UP"
    update_net_rates
    PREV_RX=$NET_RX
    PREV_TX=$NET_TX
    PREV_UP=$NOW_UP

    refresh_slow_metrics
    set_uptime "$NOW_UP"
    update_clock

    if [ "$QUIET_MODE" = true ]; then
        printf -v QLINE '[%s] CPU:%3d%%  RAM:%3d%%  DSK:%3d%%  NET D:%dKB/s U:%dKB/s  TEMP:%s' \
            "$NOW_HMS" "$CPU" "$RAM_P" "$DISK_P" "$DL" "$UL" "$CPU_TEMP_DISP"
        if [ "$ONCE_MODE" = true ] || [ ! -t 1 ]; then
            printf '%s\n' "$QLINE"
        else
            printf '\r\e[K%s' "$QLINE"
        fi
        [ "$ONCE_MODE" = true ] && break
        wait_or_key "$REFRESH_INTERVAL" && break
        continue
    fi

    if [ "$TERM_TYPE" = "gui" ]; then
        build_gui_tail

        if [ "$COLOR_MODE" = "none" ]; then
            build_gui_frame full ""
            emit_gui_frame "$FRAME"
            wait_or_key "$REFRESH_INTERVAL" && break
            continue
        fi

        build_gui_frame full "$HEART_BRIGHT"
        FRAME_SYSTOLE="$FRAME"
        build_gui_frame light "$HEART_DIM"
        FRAME_DIASTOLE="$FRAME"

        emit_gui_frame "$FRAME_SYSTOLE"
        wait_or_key "$HEART_BEAT_1" && break
        emit_gui_frame "$FRAME_DIASTOLE"
        wait_or_key "$HEART_BEAT_2" && break
        emit_gui_frame "$FRAME_SYSTOLE"
        wait_or_key "$HEART_BEAT_3" && break
        emit_gui_frame "$FRAME_DIASTOLE"
        wait_or_key "$HEART_REST" && break
    else
        build_tty_frame
        emit_tty_frame
        wait_or_key "$REFRESH_INTERVAL" && break
    fi
done

if [ "$QUIET_MODE" = true ] && [ "$ONCE_MODE" = false ] && [ -t 1 ]; then
    printf "\n"
fi
exit 0
